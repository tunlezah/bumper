{
  "_comment": [
    "Ordered HTTP scenarios for test_http_golden.py. Scenarios run in file order against one",
    "pristine Bumper instance; steps inside a scenario run in order and may depend on each other.",
    "Step fields:",
    "  method, path, port ('http' = plain config server 8007, 'https' = TLS config server 443)",
    "  body: {json: ...} | {form: {...}} | {raw: '...', content_type: '...'}",
    "  capture: {var: 'dotted.path'} stores a raw response value; later steps use ${var} in path/body,",
    "           and the normaliser reports the value as <var:NAME> where it reappears.",
    "  record: 'digest' replaces the body's 'data' field by a sha256 of its canonical JSON (large static data)",
    "  mqtt_connect: {handle, client_id, username, password} connects a fake bot with paho (no HTTP)",
    "  mqtt_disconnect: handle, with optional settle seconds",
    "Request bodies come from tests/test_confserver.py and the plugin handlers in bumper/plugins/."
  ],
  "scenarios": [
    {
      "id": "01_pristine_state",
      "description": "A fresh instance: empty device lists and the status page with only the helperbot session.",
      "steps": [
        {"name": "users GetDeviceList (empty)", "method": "POST", "port": "http", "path": "/api/users/user.do",
         "body": {"json": {"auth": {"realm": "ecouser.net", "resource": "dev_1234", "token": "token_1234", "userid": "testuser", "with": "users"}, "todo": "GetDeviceList", "userid": "testuser"}}},
        {"name": "appsvr GetGlobalDeviceList (empty)", "method": "POST", "port": "https", "path": "/api/appsvr/app.do",
         "body": {"json": {"aliliving": false, "appVer": "1.1.6", "auth": {"realm": "ecouser.net", "resource": "ECOGLOBLEac5ae987", "token": "token_1234", "userid": "testuser", "with": "users"}, "channel": "google_play", "defaultLang": "en", "lang": "en", "platform": "Android", "todo": "GetGlobalDeviceList", "userid": "testuser"}}},
        {"name": "status page", "method": "GET", "port": "http", "path": "/"},
        {"name": "status page HEAD", "method": "HEAD", "port": "http", "path": "/"},
        {"name": "status page over TLS", "method": "GET", "port": "https", "path": "/"}
      ]
    },
    {
      "id": "02_ecovacs_app_login_flow",
      "description": "Ecovacs (non-Home) app: login -> checkLogin -> getAuthCode -> loginByItToken -> logout.",
      "steps": [
        {"name": "login", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/login",
         "capture": {"token": "data.accessToken"}},
        {"name": "checkLogin with issued token", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/checkLogin?accessToken=${token}"},
        {"name": "getAuthCode", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/getAuthCode?uid=fuid_tmpuser&accessToken=${token}",
         "capture": {"authcode": "data.authCode"}},
        {"name": "getAuthCode again returns the existing code", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/getAuthCode?uid=fuid_tmpuser&accessToken=${token}"},
        {"name": "users loginByItToken with userId", "method": "POST", "port": "https", "path": "/api/users/user.do",
         "body": {"json": {"country": "US", "last": "", "realm": "ecouser.net", "resource": "dev_1234", "todo": "loginByItToken", "token": "${authcode}", "userId": "fuid_tmpuser"}}},
        {"name": "users loginByItToken with userId and wrong code", "method": "POST", "port": "https", "path": "/api/users/user.do",
         "body": {"json": {"country": "US", "last": "", "realm": "ecouser.net", "resource": "dev_1234", "todo": "loginByItToken", "token": "us_00000000000000000000000000000000", "userId": "fuid_tmpuser"}}},
        {"name": "getUserAccountInfo for non-Home app", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/getUserAccountInfo"},
        {"name": "checkAgreement", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/checkAgreement"},
        {"name": "logout", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/logout?accessToken=${token}"},
        {"name": "checkLogin with revoked token issues a new one", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/checkLogin?accessToken=${token}"},
        {"name": "checkLogin without accessToken", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/checkLogin"},
        {"name": "logout without accessToken", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_1234/ios/1/0/0/user/logout"},
        {"name": "logout unknown device", "method": "GET", "port": "https", "path": "/v1/private/us/en/dev_unknown/ios/1/0/0/user/logout?accessToken=nothing"}
      ]
    },
